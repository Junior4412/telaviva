# TelaViva — variáveis de ambiente
#
# O servidor lê process.env diretamente (sem dotenv). Localmente os valores
# abaixo já têm padrão e NÃO é preciso criar arquivo .env para rodar em dev.
# Use este arquivo como referência ao configurar Render / Cloudflare Pages.
#
#   - No Node 20.6+ você pode carregar um .env com:  node --env-file=.env ...
#   - Em produção, defina as variáveis no painel da plataforma.

# ---------------------------------------------------------------------
# Servidor de sinalização (apps/server)
# ---------------------------------------------------------------------

# Porta HTTP do servidor. O Render define PORT sozinho; não sobreponha.
# Padrão: 3001
PORT=3001

# Origens aceitas no CORS e no handshake do Socket.IO, separadas por vírgula.
# Em produção, exatamente a URL do frontend publicado (sem barra no final).
# NUNCA use "*" aqui: liberaria qualquer site a se conectar ao seu servidor.
# Padrão: http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Servidores ICE entregues aos clientes (uma URL por linha via vírgula).
# Formatos:  stun:host:port   |   turn:host:port?transport=tcp
# Deixe vazio para usar o STUN público do Google como fallback (sem SLA).
ICE_URLS=

# Segredo compartilhado do coturn no modo `static-auth-secret` /
# `use-auth-secret`. O servidor troca por credenciais temporárias (HMAC-SHA1)
# a cada requisição de /ice — o segredo NUNCA chega ao navegador.
ICE_USERNAME=

# Mesmo segredo acima. Precisa estar definido junto com ICE_USERNAME para
# ativar a geração de credenciais TURN temporárias.
ICE_SECRET=

# Validade (segundos) das credenciais TURN geradas. Padrão: 3600
ICE_TTL_SECONDS=3600

# "true" para logar detalhes de conexão em desenvolvimento. Padrão: false
DEBUG=false

# "production" em produção (controla mensagens de log). O Render já define.
NODE_ENV=production

# ---------------------------------------------------------------------
# Frontend (apps/web) — apenas variáveis VITE_* entram no bundle
# ---------------------------------------------------------------------

# URL base do backend de sinalização, sem barra no final.
# Desenvolvimento local: vazio usa http://localhost:3001
# Produção: https://SEU-SERVIDOR.onrender.com
#
# ATENÇÃO: variáveis VITE_* são embutidas no JavaScript público.
# Nunca coloque aqui segredos, chaves privadas ou credenciais TURN fixas.
VITE_SERVER_URL=
