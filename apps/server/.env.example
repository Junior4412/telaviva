# Porta HTTP do servidor de sinalização.
PORT=3001

# Ambiente: development | production
NODE_ENV=development

# Origens permitidas a se conectar via WebSocket, separadas por vírgula.
# Em produção, use a URL do Cloudflare Pages.
ALLOWED_ORIGINS=http://localhost:5173

# --- STUN / TURN (opcionais no dev, recomendados em produção) ---
# Servidores ICE entregues aos clientes pelo endpoint /ice.
# Deixe vazio para usar apenas STUN público do Google.
#
# Para TURN com credencial temporária, configure o coturn com
# `use-auth-secret` (o mesmo valor de `static-auth-secret`) e preencha os
# três campos abaixo. A cada requisição de /ice o servidor gera credenciais
# novas por HMAC-SHA1 com prazo de validade; o segredo NUNCA vai para o
# bundle do frontend.
#
# ICE_URLS=turn:turn.exemplo.com:3478?transport=udp,turns:turn.exemplo.com:5349?transport=tcp
# ICE_USERNAME=
# ICE_SECRET=
# ICE_TTL_SECONDS=3600

# Log detalhado de depuração.
DEBUG=false
